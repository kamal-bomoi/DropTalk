{
  "name": "server",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "node --import ./dist/instrument.js ./dist/index.js",
    "build": "rimraf dist dev && tsc",
    "dev": "kill-port 2300 && rimraf dist dev && tsx watch --clear-screen=false -r dotenv/config src/index.ts",
    "typecheck": "tsc --noEmit",
    "madge": "madge src/index.ts --ts-config tsconfig.json -c --warning",
    "clean": "rimraf dist dev .turbo"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@kamalyb/errors": "^4.0.0",
    "@sentry/node": "^10.73.0",
    "@sentry/profiling-node": "^10.73.0",
    "argon2": "^0.45.1",
    "consola": "^3.4.2",
    "cors": "^2.8.6",
    "envalid": "^8.2.0",
    "express": "^5.2.1",
    "express-list-routes": "^1.3.2",
    "helmet": "^8.3.0",
    "joi": "^18.2.8",
    "mediasoup": "^3.26.0",
    "nanoid": "^6.0.1",
    "node-cron": "^4.6.0",
    "socket.io": "^4.8.3",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.1",
    "@types/node-cron": "^3.0.11",
    "dotenv": "^17.4.2",
    "madge": "^8.0.0",
    "tsconfig": "*",
    "tsx": "^4.23.13",
    "types": "*",
    "typescript": "^7.0.2"
  }
}
